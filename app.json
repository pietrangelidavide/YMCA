{
  "expo": {
    "name": "YMCA Prime Training",
    "slug": "ymca-prime-training",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "ymcaprimetraining",
    "ios": {
      "bundleIdentifier": "it.example.ymcaprimetraining",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "it.example.ymcaprimetraining",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0B"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0A0A0B",
          "imageWidth": 260,
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0A0A0B"
          }
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "L'app usa la tua libreria solo per scegliere il video di un esercizio.",
          "cameraPermission": "L'app usa la fotocamera solo per registrare il video di un esercizio.",
          "microphonePermission": "L'app usa il microfono solo per registrare la voce nel video di un esercizio."
        }
      ],
      "expo-document-picker"
    ],
    "backgroundColor": "#0A0A0B"
  }
}
