{
  "expo": {
    "name": "YMCA Prime Training",
    "slug": "ymca-prime-training",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "ymcaprimetraining",
    "ios": {
      "bundleIdentifier": "it.example.ymcaprimetraining",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "it.example.ymcaprimetraining",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0B"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0A0A0B",
          "imageWidth": 260,
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0A0A0B"
          }
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "L'app usa le tue foto solo per aggiungere l'immagine di un esercizio.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-document-picker"
    ],
    "backgroundColor": "#0A0A0B"
  }
}
